---
import Base from "../layouts/Base.astro";
import CallLink from "../components/CallLink.astro";
---

<Base
  title="Get help with water damage in Georgia"
  description="Water in the house in Gwinnett or nearby? Call. A restoration company will take it from there."
>
  <article class="hero wrap" style="padding-bottom: 3rem;">
    <h1>Need help? Call.</h1>
    <p class="lede">
      Burst pipe, leak, sewage, or storm water in Dacula, Lawrenceville, or
      nearby. If you need a crew, pick up the phone. A real restoration
      company handles the call.
    </p>
    <div class="actions">
      <CallLink class="btn" prefix="Call" />
      <a class="btn secondary" href="/#request">Or send a message</a>
    </div>
    <p>
      A drip you can dry yourself is on
      <a href="/small-leaks">small leaks</a>.
    </p>
  </article>
</Base>
