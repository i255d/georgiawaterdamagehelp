---
import Base from "../layouts/Base.astro";
---

<Base
  title="Request received"
  description="Thanks. We have your water damage request."
  noindex
>
  <article class="hero wrap" style="padding-bottom: 3rem;">
    <h1>We have the request.</h1>
    <p class="lede">
      Someone from a restoration company can follow up. If it is urgent, call
      the number on this site.
    </p>
    <p>
      While you wait: stay off wet electrical areas, keep taking photos, and
      do not start demo if you plan to file insurance.
    </p>
    <div class="actions">
      <a class="btn" href="/what-to-do">First-hour checklist</a>
      <a class="btn secondary" href="/">Home</a>
    </div>
  </article>
</Base>
